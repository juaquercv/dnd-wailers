// D&D Wailers data model. JSON columns hold the typed documents defined in @wailers/shared.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id
  name         String         @unique
  color        String
  createdAt    DateTime       @default(now())
  campaigns    Campaign[]
  entries      LibraryEntry[] @relation("EntryOwner")
  favorites    Favorite[]
  recents      RecentUse[]
  savedFilters SavedFilter[]
  sessions     GameSession[]
}

/// Hierarchical categories per entry kind. Root categories act as facets (e.g. "Tipo de criatura").
model Category {
  id        String          @id @default(cuid())
  kind      String
  name      String
  parentId  String?
  parent    Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[]      @relation("CategoryTree")
  color     String?
  icon      String?
  sortOrder Int             @default(0)
  entries   EntryCategory[]
  createdAt DateTime        @default(now())

  @@index([kind])
  @@index([parentId])
}

/// Shared library: creatures/NPCs, items, spells, zone templates, sounds and heroes.
model LibraryEntry {
  id               String          @id @default(cuid())
  kind             String
  name             String
  description      String          @default("")
  imageUrl         String?
  tags             String[]
  data             Json
  level            Int?
  cr               Float?
  hp               Int?
  value            Float?
  weight           Float?
  rarity           String?
  size             String?
  ownerId          String?
  owner            User?           @relation("EntryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  originCampaignId String?
  originCampaign   Campaign?       @relation("EntryOrigin", fields: [originCampaignId], references: [id], onDelete: SetNull)
  /// Normalized (lowercase, no accents) name + description + tags + category names. Trigram + FTS indexed.
  searchText       String          @default("")
  categories       EntryCategory[]
  usages           EntryUsage[]
  favorites        Favorite[]
  recents          RecentUse[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([kind])
  @@index([ownerId])
  @@index([tags], type: Gin)
}

model EntryCategory {
  entryId    String
  categoryId String
  entry      LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([entryId, categoryId])
  @@index([categoryId])
}

/// Campaigns in which an entry has been used (origin is LibraryEntry.originCampaignId).
model EntryUsage {
  entryId    String
  campaignId String
  lastUsedAt DateTime     @default(now())
  entry      LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([entryId, campaignId])
  @@index([campaignId])
}

model Favorite {
  userId    String
  entryId   String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry     LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([userId, entryId])
}

model RecentUse {
  userId  String
  entryId String
  usedAt  DateTime     @default(now())
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry   LibraryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([userId, entryId])
  @@index([userId, usedAt])
}

model SavedFilter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      String?
  query     Json
  createdAt DateTime @default(now())

  @@index([userId])
}

model Campaign {
  id                String         @id @default(cuid())
  name              String
  description       String         @default("")
  coverUrl          String?
  ownerId           String
  owner             User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// RuleSystem
  rules             Json
  /// OverviewMap
  overview          Json
  /// SpawnPoint | null
  spawn             Json?
  /// VisibilitySettings
  defaultVisibility Json
  tags              String[]
  zones             Zone[]
  rollers           Roller[]
  sessions          GameSession[]
  originEntries     LibraryEntry[] @relation("EntryOrigin")
  usages            EntryUsage[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

/// A zone = one "slide". Sub-zones reference parentZoneId. levels holds ZoneLevel[] (scene documents).
model Zone {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name            String
  order           Int      @default(0)
  parentZoneId    String?
  zoneType        String   @default("exterior")
  biome           String   @default("")
  /// { x, y } | null
  gridPos         Json?
  /// ZoneNeighbors
  neighbors       Json
  musicSoundId    String?
  ambienceSoundId String?
  weather         String   @default("none")
  lighting        String   @default("day")
  /// ZoneLevel[]
  levels          Json
  defaultLevelId  String
  notes           String   @default("")
  tags            String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([campaignId])
}

/// Custom dice and roulettes, owned by a campaign.
model Roller {
  id           String   @id @default(cuid())
  campaignId   String
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name         String
  kind         String
  description  String   @default("")
  tags         String[]
  active       Boolean  @default(true)
  isTurnRoll   Boolean  @default(false)
  /// RouletteSegment[]
  segments     Json
  formula      String?
  /// string[] | null
  faces        Json?
  copiedFromId String?
  sortOrder    Int      @default(0)
  searchText   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([campaignId])
}

model GameSession {
  id         String       @id @default(cuid())
  campaignId String
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  hostUserId String
  host       User         @relation(fields: [hostUserId], references: [id], onDelete: Cascade)
  name       String
  /// lobby | playing | paused | ended
  status     String       @default("lobby")
  /// LiveState snapshot
  state      Json
  logs       SessionLog[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status])
  @@index([campaignId])
}

model SessionLog {
  id           String      @id @default(cuid())
  sessionId    String
  session      GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type         String
  actorUserId  String?
  actorName    String?
  /// all | dm | user
  visibility   String      @default("all")
  targetUserId String?
  text         String
  data         Json?
  createdAt    DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model AppMeta {
  key   String @id
  value String
}
