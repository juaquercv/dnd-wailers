# Configuración de D&D Wailers para Docker Compose.
# Copia este archivo como .env y ajústalo si lo necesitas.

# Puerto del equipo anfitrión por el que se accede a la aplicación desde la red local
# (http://<IP de este equipo>:APP_PORT).
APP_PORT=8080

# Credenciales de la base de datos PostgreSQL (se crean la primera vez que arranca).
# Evita caracteres especiales como @ : / # ? en la contraseña.
POSTGRES_USER=wailers
POSTGRES_PASSWORD=wailers
POSTGRES_DB=wailers

# Segundos que un usuario sigue bloqueado tras desconectarse antes de quedar libre.
USER_RELEASE_SECONDS=60
